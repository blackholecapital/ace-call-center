# ===========================================
# SMS/Email Follow-up — Environment Variables
# ===========================================

# --- Runtime ---
# "node" for Node.js server, "edge" for Cloudflare Workers
RUNTIME_TARGET=node
PORT=3000
NODE_ENV=development
APP_VERSION=pass-4-dev

# --- Logging ---
LOG_LEVEL=info        # debug | info | warn | error
LOG_FORMAT=text       # text | json

# --- Persistence ---
# "file" (default, Node), "sqlite" (Node + better-sqlite3), "memory" (edge ephemeral), "d1" (edge durable)
DB_BACKEND=file
DB_PATH=.data/db.json
SQLITE_PATH=.data/followup.sqlite

# --- SMS Provider (Twilio) ---
# Set providers.sms to "twilio" in settings to activate
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Email Provider (SendGrid) ---
# Set providers.email to "sendgrid" in settings to activate
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
