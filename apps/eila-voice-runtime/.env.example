EILA_RUNTIME_TOKEN=replace-with-a-long-random-token
EILA_HOST=0.0.0.0
EILA_PORT=8000
EILA_LOG_LEVEL=info

# Local language model. Ollama and OpenAI-compatible streaming servers are supported.
# The canonical 2026-08-17 Blackhole voice backup preserves qwen3.5:9b.
EILA_LLM_PROVIDER=ollama
EILA_LLM_BASE_URL=http://127.0.0.1:11434
EILA_LLM_MODEL=qwen3.5:9b
EILA_LLM_API_KEY=
EILA_LLM_TIMEOUT_SECONDS=90
EILA_LLM_THINK=false
EILA_LLM_KEEP_ALIVE=-1
EILA_LLM_TEMPERATURE=0.4
EILA_LLM_NUM_PREDICT=96
EILA_LLM_NUM_CTX=4096

# Self-hosted speech. One Chatterbox model can serve multiple selectable voices.
# Each voice profile lives at assets/voices/<voiceId>/reference.wav.
EILA_TTS_BACKEND=chatterbox
EILA_TTS_DEVICE=cuda
EILA_TTS_VOICE_ROOT=assets/voices
EILA_TTS_DEFAULT_VOICE=eila
# Temporary mapping: ACE uses EILA's profile until a dedicated ACE WAV is installed.
# Example later: EILA_TTS_VOICE_ALIASES=ace:eila,frontdesk:eila
EILA_TTS_VOICE_ALIASES=ace:eila
# Legacy single-reference fallback retained for older deployments.
EILA_TTS_VOICE_REFERENCE=assets/voices/eila/reference.wav
EILA_TTS_SAMPLE_RATE=24000
EILA_TTS_EXAGGERATION=0.0
EILA_TTS_CFG_WEIGHT=0.0
# Generated once at startup and reused as immediate conversational acknowledgements.
EILA_TTS_PREFACE_TEXTS='Got it.|Absolutely.|Glad to hear it.|I am doing great, thank you.'

# Twilio expects 8 kHz G.711 mu-law. Each event carries 100 ms of audio.
EILA_TELEPHONY_SAMPLE_RATE=8000
EILA_AUDIO_CHUNK_MS=100
EILA_PHRASE_MIN_WORDS=2
EILA_PHRASE_TARGET_WORDS=6
EILA_PHRASE_MAX_WORDS=18
EILA_PHRASE_FIRST_MAX_WORDS=6

# Optional asynchronous MuseTalk adapter. Voice-only requests are unaffected.
# Keep the avatar token out of browser clients and source control.
EILA_AVATAR_RUNTIME_URL=http://127.0.0.1:17102
EILA_AVATAR_RUNTIME_TOKEN_FILE=/workspace/alley-golden/.avatar-runtime-token
EILA_AVATAR_TIMEOUT_SECONDS=20
